{
  "name": "<%= projectName %>",
  "version": "1.0.0",
  "description": "Template de automação E2E com Playwright, Cucumber, Page Object Model, multi-ambiente e relatórios observáveis. Pronto para produção com boas práticas BDD, tipagem forte (TypeScript) e arquitetura orientada a comportamento.",
  "main": "index.js",
  "scripts": {
    "test": "cross-env NODE_ENV=qa cucumber-js",
    "test:smoke": "cross-env NODE_ENV=qa cucumber-js --profile smoke",
    "test:regression": "cross-env NODE_ENV=qa cucumber-js --profile regression",
    "test:qa": "cross-env NODE_ENV=qa cucumber-js",
    "test:dev": "cross-env NODE_ENV=dev cucumber-js",
    "test:headed": "cross-env NODE_ENV=qa HEADED=1 cucumber-js",
    "test:debug": "cross-env NODE_ENV=qa PWDEBUG=1 cucumber-js",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "gherkin",
    "e2e",
    "testing",
    "automation",
    "pom",
    "page-object-model",
    "template",
    "qa"
  ],
  "author": "Renato Santana de Oliveira",
  "license": "ISC",
  "homepage": "./README.md",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.18.0",
    "allure-cucumberjs": "^3.9.0",
    "allure-js-commons": "^3.9.0",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2"
  }
}
