    "@types/node": "^13.11.1",
    "@types/shelljs": "^0.8.7",
    "nodemon": "^2.0.3",
    "shx": "^0.3.2",
    "ts-node": "^8.8.2",
    "typescript": "^3.8.3"
  },
  "dependencies": {
    "chalk": "^4.1.0",
    "ejs": "^3.0.2",
    "inquirer": "^7.1.0",
